// ==============================================================================
// AAPKA ASTRO - PRODUCTION POSTGRESQL PRISMA SCHEMA
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum UserRole {
  CLIENT
  ASTROLOGER
  ADMIN
  OWNER
}

enum AstrologerPresenceStatus {
  AVAILABLE
  BUSY
  BREAK
  OFFLINE
}

enum SessionType {
  CHAT
  VOICE
  VIDEO
}

enum SessionStatus {
  WAITING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  RECHARGE
  DEBIT
  CREDIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum InstagramMediaType {
  IMAGE
  VIDEO
  REEL
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum AccessLevel {
  VIEW
  MANAGE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

// ------------------------------------------------------------------------------
// 1. User (role: client/astrologer/admin, identifier, email, phone, name, created_at)
// ------------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  clerkId       String?   @unique @map("clerk_id")
  identifier    String?   @unique // Primary user handle (email, username, or future phone)
  email         String?   @unique
  phone         String?   @unique
  name          String?
  role          UserRole  @default(CLIENT)
  walletBalance Float     @default(0.0) @map("wallet_balance")
  referralCode       String?             @unique @map("referral_code")
  referredById       String?             @map("referred_by_id")
  referralEarnings   Float               @default(0.0) @map("referral_earnings")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  // Relationships
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  clientSessions     Session[]           @relation("ClientSessions")
  astrologerSessions Session[]           @relation("AstrologerSessions")
  kundliRecords      KundliRecord[]
  kundliLeads        KundliLead[]
  staffPermissions   StaffPermission[]
  referredBy         User?               @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]              @relation("UserReferrals")

  @@index([clerkId])
  @@index([identifier])
  @@index([referralCode])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. Wallet (user_id, balance)
// ------------------------------------------------------------------------------
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0.0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions WalletTransaction[]

  @@index([userId])
  @@map("wallets")
}

// ------------------------------------------------------------------------------
// 3. WalletTransaction (user_id, amount, type: recharge/debit, order_id, status, created_at)
// ------------------------------------------------------------------------------
model WalletTransaction {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId    String?           @map("wallet_id")
  wallet      Wallet?           @relation(fields: [walletId], references: [id], onDelete: SetNull)
  amount      Float
  type        TransactionType
  orderId     String?           @map("order_id")
  paymentId   String?           @map("payment_id")
  status      TransactionStatus @default(SUCCESS)
  description String?
  provider    String            @default("upi")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// ------------------------------------------------------------------------------
// 4. Session (client_id, astrologer_id, type: chat/voice/video, start_time, end_time, rate_per_min, total_cost, status)
// ------------------------------------------------------------------------------
model Session {
  id                   String        @id @default(cuid())
  clientId             String        @map("client_id")
  client               User          @relation("ClientSessions", fields: [clientId], references: [id])
  astrologerId         String?       @map("astrologer_id")
  astrologer           User?         @relation("AstrologerSessions", fields: [astrologerId], references: [id])
  type                 SessionType
  startTime            DateTime?     @map("start_time")
  endTime              DateTime?     @map("end_time")
  ratePerMin           Float         @default(0.0) @map("rate_per_min")
  totalCost            Float         @default(0.0) @map("total_cost")
  status               SessionStatus @default(WAITING)
  notes                String?       @db.Text
  remedies             Json?
  birthDetails         Json?         @map("birth_details")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  // UPI QR & Offline/WhatsApp Consultation Delivery Fields
  bookingId            String?       @unique @map("booking_id")
  userName             String?       @map("user_name")
  userPhone            String?       @map("user_phone")
  userEmail            String?       @map("user_email")
  productType          String        @default("astro") @map("product_type") // "astro" | "vaastu" | "kundli_pdf"
  format               String        @default("Voice Call") @map("format")
  concern              String?       @db.Text
  paymentStatus        String        @default("AWAITING_VERIFICATION") @map("payment_status") // "AWAITING_VERIFICATION" | "VERIFIED" | "PAID"
  paymentMethod        String        @default("UPI_QR") @map("payment_method")
  paymentScreenshotUrl String?       @map("payment_screenshot_url")
  preferredSlot        String?       @map("preferred_slot")
  meetingLink          String?       @map("meeting_link")
  scheduledAt          DateTime?     @map("scheduled_at")

  // Manual UPI Booking Workflow Fields
  bookingStatus        String        @default("PENDING_PAYMENT") @map("booking_status") // PENDING_PAYMENT, PAYMENT_CLAIMED, CONFIRMED, SCHEDULED, COMPLETED, REJECTED, CANCELLED, EXPIRED
  utr                  String?       @map("utr")
  lockedAmount         Float         @default(0.0) @map("locked_amount")
  isFirstTimeAstro     Boolean       @default(false) @map("is_first_time_astro")
  rejectionReason      String?       @map("rejection_reason") @db.Text
  refundedAt           DateTime?     @map("refunded_at")
  refundNotes          String?       @map("refund_notes") @db.Text
  approvedAt           DateTime?     @map("approved_at")
  approvedBy           String?       @map("approved_by")
  bankCreditConfirmed  Boolean       @default(false) @map("bank_credit_confirmed")
  preferredDay         String?       @map("preferred_day")
  preferredTimeWindow  String?       @map("preferred_time_window")
  scheduledSlot        String?       @map("scheduled_slot")
  intakeDetails        Json?         @map("intake_details")
  emailStatus          String?       @map("email_status")
  emailError           String?       @map("email_error") @db.Text
  expiresAt            DateTime?     @map("expires_at")

  messages SessionMessage[]
  review   Review?

  @@index([clientId])
  @@index([astrologerId])
  @@index([bookingId])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingStatus])
  @@index([utr])
  @@index([createdAt])
  @@map("sessions")
}

// ------------------------------------------------------------------------------
// 5. SessionMessage (for chat transcripts, if storing them)
// ------------------------------------------------------------------------------
model SessionMessage {
  id             String    @id @default(cuid())
  sessionId      String    @map("session_id")
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId       String?   @map("sender_id")
  senderRole     String?   @map("sender_role") // "client" | "astrologer"
  text           String    @db.Text
  attachmentType String?   @map("attachment_type")
  attachmentData Json?     @map("attachment_data")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([createdAt])
  @@map("session_messages")
}

// ------------------------------------------------------------------------------
// 6. Review (session_id, rating, comment)
// ------------------------------------------------------------------------------
model Review {
  id         String   @id @default(cuid())
  sessionId  String?  @unique @map("session_id")
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")
  clientName String   @default("Seeker") @map("client_name")
  service    String   @default("Vedic Astrology")
  rating     Int      // 1 to 5 stars
  comment    String?  @db.Text
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

// ------------------------------------------------------------------------------
// 7. KundliRecord (user_id, dob, time_of_birth, place_of_birth, chart_data_json, is_free_chart boolean)
// ------------------------------------------------------------------------------
model KundliRecord {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  phone         String?
  email         String?
  gender        String?
  dob           DateTime
  timeOfBirth   String   @map("time_of_birth")
  placeOfBirth  String   @map("place_of_birth")
  relation      String?  @default("Self")
  latitude      Float?
  longitude     Float?
  timezone      Float?
  chartDataJson Json     @map("chart_data_json")
  isFreeChart   Boolean  @default(true) @map("is_free_chart")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([phone])
  @@index([isFreeChart])
  @@index([createdAt])
  @@map("kundli_records")
}

// ------------------------------------------------------------------------------
// 8. BlogPost (title, slug, content, cover_image, published_at, status)
// ------------------------------------------------------------------------------
model BlogPost {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  excerpt     String?        @db.Text
  content     String         @db.Text
  coverImage  String?        @map("cover_image")
  category    String         @default("Vedic Astrology")
  tags        String[]       @default([])
  publishedAt DateTime?      @map("published_at")
  status      BlogPostStatus @default(DRAFT)
  views       Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("blog_posts")
}

// ------------------------------------------------------------------------------
// 9. InstagramMedia (external_id, media_type: image/video/reel, permalink, thumbnail_url, caption, is_panchang_post boolean, panchang_date, pinned boolean, hidden boolean, fetched_at)
// ------------------------------------------------------------------------------
model InstagramMedia {
  id             String             @id @default(cuid())
  externalId     String             @unique @map("external_id")
  mediaType      InstagramMediaType @default(REEL) @map("media_type")
  permalink      String
  thumbnailUrl   String?            @map("thumbnail_url")
  caption        String?            @db.Text
  isPanchangPost Boolean            @default(false) @map("is_panchang_post")
  panchangDate   DateTime?          @map("panchang_date")
  pinned         Boolean            @default(false)
  hidden         Boolean            @default(false)
  viewsCount     String?            @map("views_count")
  likesCount     String?            @map("likes_count")
  displayOrder   Int                @default(0) @map("display_order")
  category       String?            @default("Horoscope")
  fetchedAt      DateTime           @default(now()) @map("fetched_at")

  @@index([externalId])
  @@index([pinned])
  @@index([hidden])
  @@index([isPanchangPost])
  @@index([displayOrder])
  @@index([fetchedAt])
  @@map("instagram_media")
}

// ------------------------------------------------------------------------------
// 10. InstagramSyncToken (access_token, expires_at, last_refreshed_at — single row, used by scheduled refresh job)
// ------------------------------------------------------------------------------
model InstagramSyncToken {
  id              String   @id @default("singleton_sync_token")
  accessToken     String   @map("access_token") @db.Text
  expiresAt       DateTime @map("expires_at")
  lastRefreshedAt DateTime @default(now()) @map("last_refreshed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("instagram_sync_tokens")
}

// ------------------------------------------------------------------------------
// 11. PanchangEntry (date, tithi, nakshatra, yoga, karana, sunrise, sunset, raw_data_json)
// ------------------------------------------------------------------------------
model PanchangEntry {
  id          String   @id @default(cuid())
  date        DateTime @unique
  city        String   @default("New Delhi")
  tithi       String
  nakshatra   String
  yoga        String
  karana      String
  sunrise        String
  sunset         String
  rahuKaal       String?  @map("rahu_kaal")
  abhijitMuhurat String?  @map("abhijit_muhurat")
  rawDataJson    Json     @map("raw_data_json")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([date])
  @@index([city])
  @@index([createdAt])
  @@map("panchang_entries")
}

// ------------------------------------------------------------------------------
// 12. Coupon (code, type, discount_percent, used_by_user_ids, one_time_per_user boolean)
// ------------------------------------------------------------------------------
model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType @default(PERCENTAGE)
  discountPercent Float      @map("discount_percent")
  usedByUserIds   String[]   @default([]) @map("used_by_user_ids")
  oneTimePerUser  Boolean    @default(true) @map("one_time_per_user")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@index([createdAt])
  @@map("coupons")
}

// ------------------------------------------------------------------------------
// 13. StaffPermission (per-site, per-section granular staff access controls)
// ------------------------------------------------------------------------------
model StaffPermission {
  id              String      @id @default(cuid())
  userId          String?     @map("user_id")
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String
  section         String      // "blog" | "reels" | "clients" | "earnings" | "consultations" | "pricing" | "analytics" | "staff" | "*"
  accessLevel     AccessLevel @default(MANAGE) @map("access_level")
  grantedByUserId String?     @map("granted_by_user_id")
  grantedBy       String?     @map("granted_by")
  grantedAt       DateTime    @default(now()) @map("granted_at")
  revokedAt       DateTime?   @map("revoked_at")
  revokedByUserId String?     @map("revoked_by_user_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([email])
  @@index([userId])
  @@index([grantedByUserId])
  @@index([revokedAt])
  @@map("staff_permissions")
}

// ------------------------------------------------------------------------------
// 14. ClerkWebhookEvent (Audit log of incoming user lifecycle events)
// ------------------------------------------------------------------------------
model ClerkWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String?  @map("event_id")
  eventType String   @map("event_type")
  payload   Json?
  status    String   @default("SUCCESS") // "SUCCESS" | "FAILED"
  error     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("clerk_webhook_events")
}

// ------------------------------------------------------------------------------
// 15. PlatformSetting (Persistent server-side admin configurations: pricing, promos, popups, payment settings)
// ------------------------------------------------------------------------------
model PlatformSetting {
  id              String   @id @default("singleton_settings")
  pricing         Json     @map("pricing")
  popups          Json?    @map("popups")
  features        Json?    @map("features")
  paymentSettings Json?    @map("payment_settings")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ------------------------------------------------------------------------------
// 16. AuditLog (Tamper-evident audit trail for payment settings, approvals, refunds)
// ------------------------------------------------------------------------------
model AuditLog {
  id            String   @id @default(cuid())
  action        String   @map("action")
  actorId       String?  @map("actor_id")
  actorEmail    String?  @map("actor_email")
  targetId      String?  @map("target_id")
  targetType    String?  @map("target_type")
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  notes         String?  @db.Text
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([actorEmail])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 17. KundliLead (Pre-chart generation lead capture with GDPR/DPDP explicit consent)
// ------------------------------------------------------------------------------
model KundliLead {
  id               String    @id @default(cuid())
  name             String    @map("name")
  phone            String    @map("phone")
  email            String?   @map("email")
  gender           String    @default("male") @map("gender")
  dob              DateTime  @map("dob")
  timeOfBirth      String    @map("time_of_birth")
  placeOfBirth     String    @map("place_of_birth")
  latitude         Float?    @map("latitude")
  longitude        Float?    @map("longitude")
  timezone         Float?    @map("timezone")
  sourcePage       String    @default("/kundli-generator") @map("source_page")
  userId           String?   @map("user_id")
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  consentGiven     Boolean   @default(true) @map("consent_given")
  consentText      String    @map("consent_text") @db.Text
  consentVersion   String    @default("v1.0") @map("consent_version")
  consentTimestamp DateTime  @default(now()) @map("consent_timestamp")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([phone])
  @@index([email])
  @@index([userId])
  @@index([consentTimestamp])
  @@index([createdAt])
  @@map("kundli_leads")
}

// ------------------------------------------------------------------------------
// 18. KnowledgeEntry (Owner-editable verified knowledge base for AI Assistant)
// ------------------------------------------------------------------------------
model KnowledgeEntry {
  id         String   @id @default(cuid())
  question   String   @db.Text
  answer     String   @db.Text
  language   String   @default("en") // "en", "hi", "hinglish"
  category   String   @default("general") // "services", "pricing", "acharya", "vaastu", "faq", "general"
  published  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([published, language])
  @@index([category])
  @@map("knowledge_entries")
}

// ------------------------------------------------------------------------------
// 19. UnansweredQuestion (Logged low-confidence questions with PII masked; 30-day retention)
// ------------------------------------------------------------------------------
model UnansweredQuestion {
  id          String   @id @default(cuid())
  question    String   @db.Text // Truncated to 500 chars, phone numbers and emails masked
  language    String   @default("en")
  count       Int      @default(1)
  resolved    Boolean  @default(false)
  lastAskedAt DateTime @default(now()) @map("last_asked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([resolved])
  @@index([lastAskedAt])
  @@index([createdAt])
  @@map("unanswered_questions")
}

// ------------------------------------------------------------------------------
// 20. GeocodeCache (Caches Nominatim & external geocoding queries in PostgreSQL)
// ------------------------------------------------------------------------------
model GeocodeCache {
  id        String   @id @default(cuid())
  query     String   @unique
  results   Json
  provider  String   @default("nominatim")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([query])
  @@map("geocode_cache")
}

// ------------------------------------------------------------------------------
// 21. ContentEntry (Typed collections of editable content in EN & HI)
// ------------------------------------------------------------------------------
model ContentEntry {
  id            String          @id @default(cuid())
  collection    String          @map("collection")
  key           String          @map("key")
  slug          String?         @map("slug")
  status        ContentStatus   @default(PUBLISHED)
  sortOrder     Int             @default(0) @map("sort_order")
  schemaVersion String          @default("1.0") @map("schema_version")
  dataEn        Json            @default("{}") @map("data_en")
  dataHi        Json            @default("{}") @map("data_hi")
  metadata      Json?           @default("{}") @map("metadata")
  createdBy     String?         @map("created_by")
  updatedBy     String?         @map("updated_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  revisions     ContentRevision[]

  @@unique([collection, key])
  @@index([collection, status, sortOrder])
  @@index([status])
  @@map("content_entries")
}

// ------------------------------------------------------------------------------
// 22. ContentRevision (Snapshot on every save, with restore)
// ------------------------------------------------------------------------------
model ContentRevision {
  id             String        @id @default(cuid())
  contentId      String        @map("content_id")
  content        ContentEntry  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  collection     String        @map("collection")
  key            String        @map("key")
  status         ContentStatus @default(PUBLISHED)
  sortOrder      Int           @default(0) @map("sort_order")
  dataEn         Json          @map("data_en")
  dataHi         Json          @map("data_hi")
  metadata       Json?         @map("metadata")
  revisionNumber Int           @default(1) @map("revision_number")
  changeSummary  String?       @map("change_summary")
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([contentId, revisionNumber])
  @@index([collection, key])
  @@map("content_revisions")
}

// ------------------------------------------------------------------------------
// 23. MediaAsset (Uploaded images, videos, certificates, and attachments)
// ------------------------------------------------------------------------------
model MediaAsset {
  id          String   @id @default(cuid())
  url         String   @map("url")
  filename    String   @map("filename")
  mimeType    String   @default("image/jpeg") @map("mime_type")
  fileSize    Int?     @map("file_size")
  altTextEn   String?  @map("alt_text_en")
  altTextHi   String?  @map("alt_text_hi")
  collection  String?  @map("collection")
  uploadedBy  String?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([collection])
  @@index([url])
  @@map("media_assets")
}


