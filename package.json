{
  "name": "aapka-astro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "start": "next start",
    "lint": "eslint src/ --max-warnings=1000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env.test --test --test-concurrency=1 tests/**/*.test.ts",
    "verify": "node scripts/verify.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/prisma-guard.js migrate deploy",
    "prisma:db-push": "node scripts/prisma-guard.js db push",
    "prisma:reset": "node scripts/prisma-guard.js migrate reset",
    "seed:content": "tsx scripts/seed-content.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@prisma/client": "6.4.1",
    "@types/qrcode": "^1.5.6",
    "astronomy-engine": "^2.1.19",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "prisma": "6.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "svix": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "tz-lookup": "^6.1.25",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tz-lookup": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
