# ==============================================================================
# AAPKA ASTRO - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and configure your credentials.
#
# SWAPPABLE PROVIDERS:
# - PAYMENT_PROVIDER: mock | razorpay
# - CALL_PROVIDER: mock | agora | zegocloud
# - STORAGE_PROVIDER: mock | s3 | r2
# ==============================================================================

# Node Environment & Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database: Neon Serverless (Free Tier Recommended)
# ------------------------------------------------------------------------------
# We recommend Neon (https://neon.tech) free tier over Supabase:
# - Auto-resumes on demand (Supabase pauses project after 7 days of inactivity).
# - 3 GiB storage per branch (ample for metadata; media is on Cloudflare R2).
# - Zero recurring monthly minimums ($0/month).
#
# IMPORTANT FOR SERVERLESS:
# Use the POOLED connection string (containing "-pooler") for DATABASE_URL.
# Vercel serverless functions spin up short-lived invocations; PgBouncer pooling
# prevents connection pool exhaustion under concurrent consultation traffic.
#
# 1A. Application Runtime Connection (POOLED endpoint):
DATABASE_URL="postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# 1B. Prisma CLI Migrations Connection (DIRECT endpoint):
# Required by "npx prisma migrate deploy" for non-pooled advisory locks:
DIRECT_URL="postgresql://[user]:[password]@[endpoint-id].[region].aws.neon.tech/[dbname]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Redis Cache, Real-Time Presence & Live Waiting Queue
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. Clerk Authentication (Email/Password + Google OAuth, Multi-Domain SSO)
# ------------------------------------------------------------------------------
# Get your Clerk API keys from https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_Y2xlcmsuYWFwa2Fhc3Ryby5jb20k"
CLERK_SECRET_KEY="sk_test_clerk_secret_key_change_in_production"

# Auth routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/account"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/account"

# Multi-Domain / Satellite Configuration:
# - On Primary Domain (aapkaastro.com): NEXT_PUBLIC_CLERK_IS_SATELLITE=false
# - On Satellite Domains (viar.in, dowconsulting.in): NEXT_PUBLIC_CLERK_IS_SATELLITE=true
NEXT_PUBLIC_CLERK_DOMAIN="aapkaastro.com"
NEXT_PUBLIC_CLERK_IS_SATELLITE=false

# Legacy JWT secret (for backward-compatible session bridges if needed)
JWT_SECRET="aapka-astro-super-secure-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="30d"

# ------------------------------------------------------------------------------
# 3B. Site Owner Recognition & Per-Section Staff Permissions
# ------------------------------------------------------------------------------
# OWNER_EMAIL: Comma-separated list of Owner email accounts. When a user with this
# email logs in (via Google OAuth or email OTP), they are automatically and
# securely elevated to platform OWNER with unrestricted access to every section
# and action. Non-owners can NEVER claim or self-assign the OWNER role.
# CRITICAL: Set this in production (e.g. Vercel Project Settings) to the client's real email!
OWNER_EMAIL="anmol@aapkaastro.com,acharya@aapkaastro.com"
NEXT_PUBLIC_OWNER_EMAIL="anmol@aapkaastro.com"

# Per-Section Staff Permissions Architecture:
# - Stored in the site's own free Neon PostgreSQL database ("staff_permissions" table).
# - Zero recurring cost: does NOT require Clerk's paid Organizations plan ($99+/mo).
# - Strict per-site isolation: staff granted access on Aapka Astro receive ZERO
#   access to other platforms (viar.in or dowconsulting.in) unless explicitly added there.
# - Granular access levels: VIEW (read-only) vs MANAGE (create, edit, publish, delete, pricing).
# - Configurable sections: "blog", "reels", "clients", "earnings", "consultations", "pricing", "analytics".
# - Team Access Console: Located at /admin/team, strictly restricted to Site Owner.

# ------------------------------------------------------------------------------
# 4. Configurable Email Sign-Up Policy & Anti-Abuse (Allowlist vs Blocklist)
# ------------------------------------------------------------------------------
# Choose which sign-up policy best aligns with your customer onboarding goals:
#
# MODE 1: "blocklist" (RECOMMENDED DEFAULT)
#   Permits any legitimate email address (Gmail, Yahoo, Outlook, iCloud, plus any
#   corporate/work domain), but strictly blocks known disposable/temporary email
#   providers (Mailinator, TempMail, 10MinuteMail, GuerrillaMail, Yopmail, etc.).
#   Benefit: Stops throwaway spam signups without rejecting real paying customers.
#
# MODE 2: "allowlist"
#   Strictly blocks all registrations EXCEPT domains explicitly listed in ALLOWLIST.
#   Warning: Users with corporate, university, or unlisted domains cannot register.
#
# Switching modes: set SIGNUP_EMAIL_POLICY_MODE="blocklist" OR "allowlist"
SIGNUP_EMAIL_POLICY_MODE="blocklist"
NEXT_PUBLIC_SIGNUP_EMAIL_POLICY_MODE="blocklist"

# Comma-separated list for Allowlist mode (defaults to top global & Indian providers):
# SIGNUP_EMAIL_ALLOWLIST="gmail.com,yahoo.com,yahoo.co.in,outlook.com,hotmail.com,icloud.com,proton.me,zoho.com,rediffmail.com"
# NEXT_PUBLIC_SIGNUP_EMAIL_ALLOWLIST="gmail.com,yahoo.com,yahoo.co.in,outlook.com,hotmail.com,icloud.com,proton.me,zoho.com,rediffmail.com"

# Optional additional disposable/spam domains to block in addition to the 100+ bundled list:
# SIGNUP_EMAIL_BLOCKLIST="customspamdomain.com,temporaryinbox.org"
# NEXT_PUBLIC_SIGNUP_EMAIL_BLOCKLIST="customspamdomain.com,temporaryinbox.org"

# --- CLERK DASHBOARD NATIVE ENFORCEMENT ---
# To enforce domain restrictions directly in Clerk's engine so it cannot be bypassed
# even via direct API calls:
# 1. Open your Clerk Dashboard: https://dashboard.clerk.com/
# 2. Go to "User & Authentication" -> "Email, Phone, Username".
# 3. Under "Restrictions", find "Email domain restrictions".
# 4. Select "Block email domains" (recommended) and add disposable domains, OR
#    select "Allow specific email domains" and input your allowed domains.
# 5. Save changes. Our UI components automatically map Clerk restriction errors to
#    friendly, supportive explanation banners for your seekers.


# ------------------------------------------------------------------------------
# 5. Payment Gateway: Razorpay (Swappable: mock | razorpay)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID="rzp_test_mock_key_id"
RAZORPAY_KEY_SECRET="rzp_test_mock_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_for_signature_verification"

# ------------------------------------------------------------------------------
# 6. Live Audio/Video Calling (Direct WhatsApp / Google Meet Architecture)
# ------------------------------------------------------------------------------
# Live consultations are conducted directly via WhatsApp Call or Google Meet,
# eliminating expensive third-party per-minute RTC charges (Agora/ZegoCloud).
# Optional legacy mock provider kept for backward compatibility:
CALL_PROVIDER=mock
# AGORA_APP_ID=""
# AGORA_APP_CERTIFICATE=""

# ------------------------------------------------------------------------------
# 7. Cloud Asset Storage: AWS S3 / Cloudflare R2 (Swappable: mock | s3 | r2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=mock
S3_BUCKET="aapka-astro-assets"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 8. Instagram Reels Sync (Meta Graph API)
# ------------------------------------------------------------------------------
# Long-lived access token for @aapkaastrologer Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# 9. Scheduled Automation & Cron Secret
# ------------------------------------------------------------------------------
# Secure token passed in Authorization: Bearer <CRON_SECRET> to invoke /api/cron/*
CRON_SECRET="aapka_astro_cron_secret_token_change_in_production"

# ------------------------------------------------------------------------------
# 10. Self-Hosted Socket.io Port (Optional)
# ------------------------------------------------------------------------------
SOCKET_PORT=3001
