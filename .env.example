INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# 9. Scheduled Automation & Cron Secret
# ------------------------------------------------------------------------------
# Secure token passed in Authorization: Bearer <CRON_SECRET> to invoke /api/cron/*
CRON_SECRET="aapka_astro_cron_secret_token_change_in_production"

# ------------------------------------------------------------------------------
# 10. Self-Hosted Socket.io Port (Optional)
# ------------------------------------------------------------------------------
SOCKET_PORT=3001

# ------------------------------------------------------------------------------
# 11. Floating AI Assistant (Architecture, Cost Control & Privacy)
# ------------------------------------------------------------------------------
# Swappable Chat Provider options:
# - CHATBOT_PROVIDER: "gemini" (Google Gemini 2.0 Flash)
#                     "groq"   (Llama 3.1 8B Instant)
#                     "openai" (GPT-4o Mini)
#                     "mock"   (deterministic grounded engine at $0 cost)
# - CHATBOT_MODEL: REQUIRED when CHATBOT_PROVIDER is not "mock".
#   IMPORTANT: Google retired the Gemini 1.5 models. Developers MUST verify
#   the current active model name in the provider's official documentation.
#   Recommended active models:
#     - Gemini: "gemini-2.0-flash" (or current active Gemini release)
#     - Groq:   "llama-3.1-8b-instant"
#     - OpenAI: "gpt-4o-mini"
#
# PRIVACY & DATA TRAINING SAFETY:
# Use a small, fast, low-cost model on a PAID tier where API training on customer data
# is contractually disabled (e.g. Google AI Studio paid tier, Groq paid API, or OpenAI paid tier).
# Free public consumer tiers of some providers may use customer inputs to improve models.
#
# SECURITY, QUOTA & IN-APP DAILY CAP PROTECTION:
# - CHATBOT_API_KEY lives strictly on the server and is NEVER sent to the browser.
# - If CHATBOT_API_KEY or CHATBOT_MODEL is omitted in production, the assistant widget
#   cleanly disables itself to prevent visitors from seeing a broken bot.
# - IN-APP DAILY MESSAGE CAP: Provider budget settings are typically alerts, not hard
#   stops. Therefore, the in-app daily cap (CHATBOT_DAILY_MESSAGE_CAP, default 1000)
#   is the authoritative, hard spending protection that stops runaway traffic.
# - CIRCUIT BREAKER: On model-not-found, auth, or quota errors, the system logs the error,
#   surfaces a friendly WhatsApp escalation fallback to visitors, and automatically
#   hides the floating widget upon repeated consecutive failures.
# - Unanswered queries are logged with emails and phone numbers masked, and automatically
#   purged by the 30-day retention cron job.
#
CHATBOT_PROVIDER="gemini"
CHATBOT_MODEL="gemini-2.0-flash"
CHATBOT_API_KEY=""
CHATBOT_DAILY_MESSAGE_CAP=1000
CHATBOT_ENABLE_FALLBACK="false"

